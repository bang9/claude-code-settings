#!/usr/bin/env bash
#
# pre-commit — quiet, staged-only quality gate.
#
#   Checks (in order):  gitleaks (secret scan) -> oxlint -> oxfmt --check
#   Contract:           success = ZERO output, exit 0.
#                       On failure, emit ONLY the failing tool's captured
#                       output to stderr and exit 1 (no log/context waste).
#   Scope:              staged files only (--diff-filter=ACMR).
#                       gitleaks scans all staged content whenever anything is
#                       staged; oxlint/oxfmt run on staged JS/TS files only and
#                       silently pass when none are staged.
#   Missing tool:       one visible one-line warning to stderr, then pass.
#                       A missing tool never blocks a commit.
#
# macOS /bin/bash 3.2 compatible: no arrays, no mapfile. Staged JS/TS files are
# gathered via an IFS=newline loop into positional params ($@), so empty
# expansion under `set -u` is safe.

set -u

# Nothing staged (git usually blocks this, but be safe) -> nothing to do.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# Gather staged JS/TS files into $@ (bash 3.2 safe; splits on newline only so
# paths with spaces survive).
set --
OLDIFS=$IFS
IFS='
'
for f in $staged; do
  case "$f" in
    *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs|*.mts|*.cts) set -- "$@" "$f" ;;
  esac
done
IFS=$OLDIFS

have() { command -v "$1" >/dev/null 2>&1; }

# Capture-and-suppress: run a tool, discard its output on success, and on
# failure emit only that tool's output (stdout+stderr) before aborting.
fail() { printf '%s\n' "$1" >&2; exit 1; }

# 1. gitleaks — secret scan over the staged diff.
if have gitleaks; then
  out=$(gitleaks protect --staged --no-banner --redact 2>&1) || fail "$out"
else
  printf 'pre-commit: gitleaks not installed — skipping secret scan\n' >&2
fi

# 2 & 3. oxlint then oxfmt --check over staged JS/TS files.
if [ "$#" -gt 0 ]; then
  if have oxlint; then
    out=$(oxlint "$@" 2>&1) || fail "$out"
  else
    printf 'pre-commit: oxlint not installed — skipping lint\n' >&2
  fi

  if have oxfmt; then
    out=$(oxfmt --check "$@" 2>&1) || fail "$out"
  else
    printf 'pre-commit: oxfmt not installed — skipping format check\n' >&2
  fi
fi

exit 0
